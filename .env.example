# Required by Better Auth at build and runtime
MONGODB_URI=
MONGODB_DATABASE=
BETTER_AUTH_SECRET=

# Set these to the deployed site origin; NEXT_PUBLIC_APP_URL is embedded at build time
BETTER_AUTH_URL=https://YOUR-SITE.netlify.app
NEXT_PUBLIC_APP_URL=https://YOUR-SITE.netlify.app

# Optional OAuth providers: set both values for each provider you enable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional legacy GitHub aliases; GITHUB_ID/GITHUB_SECRET take precedence
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
